{
  "name": "rypto",
  "type": "module",
  "version": "0.0.0",
  "description": "A typescript project created from a template.",
  "author": "FriquetLuca",
  "license": "MIT",
  "homepage": "https://github.com/FriquetLuca/rypto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FriquetLuca/rypto.git"
  },
  "bugs": {
    "url": "https://github.com/FriquetLuca/rypto/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test:watch": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,html,css}\" --log-level silent",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "**/*.{js,ts,mjs,mts,json}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts"
}
