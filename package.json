{
  "name": "rypto",
  "type": "module",
  "private": true,
  "workspaces": [
    "rypto"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs,ts,mts,json}\" --log-level silent"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  },
  "lint-staged": {
    "**/*.{js,ts,mjs,mts,json}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
