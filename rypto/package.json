{
  "name": "rypto",
  "type": "module",
  "version": "0.0.0",
  "description": "A typescript project created from a template.",
  "author": "FriquetLuca",
  "license": "MIT",
  "homepage": "https://github.com/FriquetLuca/rypto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FriquetLuca/rypto.git"
  },
  "bugs": {
    "url": "https://github.com/FriquetLuca/rypto/issues"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "npm run --silent clean && tsdown",
    "dev": "tsdown --watch",
    "docs": "typedoc --router module --interfacePropertiesFormat table --readme none",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "main": "./dist/neutral/index.cjs",
  "module": "./dist/neutral/index.js",
  "types": "./dist/neutral/index.d.cts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/neutral/index.d.ts",
        "require": "./dist/neutral/index.d.cts"
      },
      "import": "./dist/neutral/index.js",
      "require": "./dist/neutral/index.cjs"
    },
    "./node": {
      "types": {
        "import": "./dist/node/node.d.ts",
        "require": "./dist/node/node.d.cts"
      },
      "import": "./dist/node/node.mjs",
      "require": "./dist/node/node.cjs"
    },
    "./package.json": "./package.json"
  }
}
